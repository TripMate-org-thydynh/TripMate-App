<?xml version="1.0" encoding="utf-8"?>
<!--
  Ô 4x4 trên màn hình chính.

  Kích thước lớn là cố ý: widget này khoe ẢNH, không phải thông tin. Ô 2x2 thu
  ảnh xuống quá nhỏ để nhận ra ai trong hình — mà đó chính là điều khiến người
  ta liếc vào nó.

  `targetCellWidth/Height` là API 31+; `minWidth/minHeight` giữ cho máy cũ hơn
  vẫn ra đúng cỡ (mỗi ô lưới ~ 70dp, nên 4 ô ~ 250dp).
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:initialLayout="@layout/tripmate_widget"
    android:minWidth="250dp"
    android:minHeight="250dp"
    android:targetCellWidth="4"
    android:targetCellHeight="4"
    android:minResizeWidth="180dp"
    android:minResizeHeight="180dp"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:previewLayout="@layout/tripmate_widget"
    android:description="@string/widget_description"
    android:updatePeriodMillis="1800000" />
