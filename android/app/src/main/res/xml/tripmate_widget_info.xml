<?xml version="1.0" encoding="utf-8"?>
<!--
  Ô 2x2 — cỡ widget tiêu chuẩn.

  Vẫn cho phép kéo to ra (`resizeMode`) nếu người dùng muốn ảnh lớn hơn, nhưng
  mặc định về đúng cỡ quen thuộc như phần lớn widget khác trên màn hình chính.

  `targetCellWidth/Height` là API 31+; `minWidth/minHeight` giữ cho máy cũ hơn
  vẫn ra đúng cỡ (mỗi ô lưới ~ 70dp, nên 2 ô ~ 140dp).
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:initialLayout="@layout/tripmate_widget"
    android:minWidth="140dp"
    android:minHeight="140dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:previewLayout="@layout/tripmate_widget"
    android:description="@string/widget_description"
    android:updatePeriodMillis="1800000" />
