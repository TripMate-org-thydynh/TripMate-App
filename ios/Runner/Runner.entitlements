<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Group: vùng lưu chung giữa app và widget. Phải khớp
	     WidgetSync.appGroupId bên Flutter và entitlements của widget. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.tripmate.app</string>
	</array>
</dict>
</plist>
